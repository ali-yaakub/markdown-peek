# Normalise to LF in the repository. Windows checkouts still get CRLF where the
# tooling wants it, and the diff stops being one big whitespace change.
* text=auto eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.sln   text eol=crlf
*.vcxproj text eol=crlf

*.png   binary
*.ico   binary
*.lib   binary
*.dll   binary

# Not our code. Keeping it out of the language statistics and the diff view.
include/**            linguist-vendored
third_party/**        linguist-vendored
assets/vendor/**      linguist-vendored
