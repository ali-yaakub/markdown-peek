root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,json,html,css,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf

# Vendored. Left exactly as upstream wrote it.
[{include,third_party,assets/vendor}/**]
trim_trailing_whitespace = false
insert_final_newline = false
